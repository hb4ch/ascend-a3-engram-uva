#include "kernel_operator.h"

using namespace AscendC;

// Full DDR INT8 rows, FP32 scales in HBM, BF16 output in HBM.
// Two queued input/output buffers overlap MTE2, vector compute and MTE3.
template <uint32_t TILE, bool PIPELINED = true>
class GatherPipeline {
public:
    __aicore__ inline void Init(GM_ADDR wp, GM_ADDR sp, GM_ADDR ip, GM_ADDR op, uint32_t n) {
        weights.SetGlobalBuffer((__gm__ int8_t*)wp);
        scales.SetGlobalBuffer((__gm__ float*)sp);
        ids.SetGlobalBuffer((__gm__ int64_t*)ip);
        out.SetGlobalBuffer((__gm__ bfloat16_t*)op);
        rows = n;

        pipe.InitBuffer(inQ, 2, TILE * (256 + 32));
        pipe.InitBuffer(outQ, 2, TILE * 256 * 2);
        pipe.InitBuffer(idBuf, ((TILE * 8 + 31) / 32) * 32);
        pipe.InitBuffer(halfBuf, TILE * 256 * 2);
        pipe.InitBuffer(fpBuf, TILE * 256 * 4);
        pipe.InitBuffer(scaleBuf, TILE * 256 * 4);
    }

    __aicore__ inline void CopyIn(uint32_t tile) {
        uint32_t start = tile * TILE;
        uint32_t count = rows - start < TILE ? rows - start : TILE;

        auto localIds = idBuf.Get<int64_t>();
        // MTE2 avoids stale scalar-GM metadata; exact-length copy also handles tails.
        DataCopyExtParams cp{1, count * 8, 0, 0, 0};
        DataCopyPadExtParams<int64_t> pad{false, 0, 0, 0};
        DataCopyPad(localIds, ids[start], cp, pad);
        event_t ready = static_cast<event_t>(pipe.FetchEventID(HardEvent::MTE2_S));
        SetFlag<HardEvent::MTE2_S>(ready);
        WaitFlag<HardEvent::MTE2_S>(ready);

        auto input = inQ.template AllocTensor<int8_t>();
        auto localScales = input.template ReinterpretCast<float>()[TILE * 64];

        for (uint32_t i = 0; i < count; i++) {
            int64_t id = localIds.GetValue(i);
            DataCopy(input[i * 256], weights[id * 256], 256);
            DataCopy(localScales[i * 8], scales[id * 8], 8);
        }

        inQ.EnQue(input);
    }

    __aicore__ inline void Compute(uint32_t count) {
        auto input = inQ.template DeQue<int8_t>();
        auto localScales = input.template ReinterpretCast<float>()[TILE * 64];
        auto h = halfBuf.Get<half>();
        auto f = fpBuf.Get<float>();
        auto expanded = scaleBuf.Get<float>();
        auto result = outQ.template AllocTensor<bfloat16_t>();

        Cast(h, input, RoundMode::CAST_NONE, count * 256);
        PipeBarrier<PIPE_V>();
        Cast(f, h, RoundMode::CAST_NONE, count * 256);

        // Each FP32 scale becomes 32 adjacent elements: four 8-float blocks.
        BrcbRepeatParams br{4, 32};
        for (uint32_t part = 0; part < 4; part++) {
            Brcb(expanded[part * 8], localScales, (uint8_t)count, br);
        }
        PipeBarrier<PIPE_V>();
        Mul(f, f, expanded, count * 256);
        PipeBarrier<PIPE_V>();
        Cast(result, f, RoundMode::CAST_RINT, count * 256);

        outQ.EnQue(result);
        inQ.FreeTensor(input);
    }

    __aicore__ inline void CopyOut(uint32_t tile, uint32_t count) {
        auto result = outQ.template DeQue<bfloat16_t>();
        DataCopy(out[tile * TILE * 256], result, count * 256);
        outQ.FreeTensor(result);
    }

    __aicore__ inline void Process() {
        uint32_t total = (rows + TILE - 1) / TILE;
        uint32_t tile = GetBlockIdx();
        if (tile >= total) {
            return;
        }
        if constexpr (PIPELINED) {
            CopyIn(tile);
        }

        for (; tile < total; tile += GetBlockNum()) {
            uint32_t next = tile + GetBlockNum();
            if constexpr (PIPELINED) {
                if (next < total) {
                    CopyIn(next);
                }
            } else {
                CopyIn(tile);
            }

            uint32_t start = tile * TILE;
            uint32_t count = rows - start < TILE ? rows - start : TILE;
            Compute(count);
            CopyOut(tile, count);
            if constexpr (!PIPELINED) {
                PipeBarrier<PIPE_ALL>();
            }
        }
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 2> inQ;
    TQue<QuePosition::VECOUT, 2> outQ;
    TBuf<TPosition::VECCALC> idBuf;
    TBuf<TPosition::VECCALC> halfBuf;
    TBuf<TPosition::VECCALC> fpBuf;
    TBuf<TPosition::VECCALC> scaleBuf;
    GlobalTensor<int8_t> weights;
    GlobalTensor<float> scales;
    GlobalTensor<int64_t> ids;
    GlobalTensor<bfloat16_t> out;
    uint32_t rows;
};

template <uint32_t TILE, bool PIPELINED = true>
__global__ __aicore__ void gather_pipeline(
    GM_ADDR w, GM_ADDR s, GM_ADDR ids, GM_ADDR out, uint32_t rows) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    GatherPipeline<TILE, PIPELINED> op;
    op.Init(w, s, ids, out, rows);
    op.Process();
}

template <bool PIPELINED>
void dispatch(void* w,
    void* s,
    void* ids,
    void* out,
    uint32_t rows,
    uint32_t tile,
    uint32_t cores,
    void* stream) {
    if (!rows) {
        return;
    }
    if (tile == 1) {
        gather_pipeline<1, PIPELINED><<<(rows < cores ? rows : cores), nullptr, stream>>>(
            (uint8_t*)w, (uint8_t*)s, (uint8_t*)ids, (uint8_t*)out, rows);
    } else if (tile == 16) {
        uint32_t tiles = (rows + 15) / 16;
        gather_pipeline<16, PIPELINED><<<(tiles < cores ? tiles : cores), nullptr, stream>>>(
            (uint8_t*)w, (uint8_t*)s, (uint8_t*)ids, (uint8_t*)out, rows);
    } else {
        uint32_t tiles = (rows + 7) / 8;
        gather_pipeline<8, PIPELINED><<<(tiles < cores ? tiles : cores), nullptr, stream>>>(
            (uint8_t*)w, (uint8_t*)s, (uint8_t*)ids, (uint8_t*)out, rows);
    }
}

extern "C" void launch_gather_config(void* w,
    void* s,
    void* ids,
    void* out,
    uint32_t rows,
    uint32_t tile,
    uint32_t cores,
    uint32_t pipelined,
    void* stream) {
    if (!cores) {
        return;
    }
    if (pipelined) {
        dispatch<true>(w, s, ids, out, rows, tile, cores, stream);
    } else {
        dispatch<false>(w, s, ids, out, rows, tile, cores, stream);
    }
}

extern "C" void launch_gather(void* w, void* s, void* ids, void* out, uint32_t rows, void* stream) {
    dispatch<true>(w, s, ids, out, rows, rows < 320 ? 1 : 8, 48, stream);
}
