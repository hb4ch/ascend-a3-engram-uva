#include "kernel_operator.h"
using namespace AscendC;
__global__ __aicore__ void hash_real(GM_ADDR tp,GM_ADDR mp,GM_ADDR cp,GM_ADDR mulp,GM_ADDR pp,GM_ADDR op,GM_ADDR hp,uint32_t batch,uint32_t length,int64_t pad){
 GlobalTensor<int64_t> t,c,mul,prime,off,out;GlobalTensor<int32_t> mask;
 t.SetGlobalBuffer((__gm__ int64_t*)tp);mask.SetGlobalBuffer((__gm__ int32_t*)mp);c.SetGlobalBuffer((__gm__ int64_t*)cp);
 mul.SetGlobalBuffer((__gm__ int64_t*)mulp);prime.SetGlobalBuffer((__gm__ int64_t*)pp);off.SetGlobalBuffer((__gm__ int64_t*)op);out.SetGlobalBuffer((__gm__ int64_t*)hp);
 TPipe pipe;TBuf<TPosition::VECCALC> hb;pipe.InitBuffer(hb,64);auto hs=hb.Get<int64_t>();
 for(uint32_t task=GetBlockIdx();task<batch*length*2;task+=GetBlockNum()){
  uint32_t layer=task%2,token=task/2,b=token/length,pos=3+token%length;int64_t ids[4];bool blocked=false;
  for(int j=0;j<4;j++){if(!mask.GetValue(b*(length+3)+pos-j))blocked=true;ids[j]=blocked?pad:c.GetValue(t.GetValue(b*(length+3)+pos-j));}
  uint64_t rolling=(uint64_t)(ids[0]*mul.GetValue(layer*4));
  for(int j=1;j<4;j++){
   rolling^=(uint64_t)(ids[j]*mul.GetValue(layer*4+j));
   for(int h=0;h<8;h++){int col=(j-1)*8+h;hs.SetValue(h,(int64_t)(rolling%(uint64_t)prime.GetValue(layer*24+col))+off.GetValue(layer*24+col));}
   pipe_barrier(PIPE_ALL);DataCopy(out[(layer*batch*length+token)*24+(j-1)*8],hs,8);pipe_barrier(PIPE_ALL);
  }
 }
}
extern "C" void launch_hash(void** p,uint32_t batch,uint32_t length,int64_t pad,void* stream){hash_real<<<batch*length*2<40?batch*length*2:40,nullptr,stream>>>((uint8_t*)p[0],(uint8_t*)p[1],(uint8_t*)p[2],(uint8_t*)p[3],(uint8_t*)p[4],(uint8_t*)p[5],(uint8_t*)p[6],batch,length,pad);}
