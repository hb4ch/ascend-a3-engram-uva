#include "kernel_operator.h"

using namespace AscendC;

__global__ __aicore__ void gather_real(
    GM_ADDR tablePtr, GM_ADDR scalePtr, GM_ADDR idsPtr, GM_ADDR outPtr, uint32_t rows) {
    GlobalTensor<int8_t> table;
    GlobalTensor<float> scales;
    GlobalTensor<int64_t> ids;
    GlobalTensor<bfloat16_t> out;
    table.SetGlobalBuffer((__gm__ int8_t*)tablePtr);
    scales.SetGlobalBuffer((__gm__ float*)scalePtr);
    ids.SetGlobalBuffer((__gm__ int64_t*)idsPtr);
    out.SetGlobalBuffer((__gm__ bfloat16_t*)outPtr);

    TPipe p;
    TBuf<TPosition::VECCALC> b0;
    TBuf<TPosition::VECCALC> b1;
    TBuf<TPosition::VECCALC> b2;
    TBuf<TPosition::VECCALC> b3;
    p.InitBuffer(b0, 256);
    p.InitBuffer(b1, 512);
    p.InitBuffer(b2, 1024);
    p.InitBuffer(b3, 512);
    auto raw = b0.Get<int8_t>();
    auto halfrow = b1.Get<half>();
    auto fp = b2.Get<float>();
    auto result = b3.Get<bfloat16_t>();
    for (uint32_t r = GetBlockIdx(); r < rows; r += GetBlockNum()) {
        int64_t id = ids.GetValue(r);
        DataCopy(raw, table[id * 256], 256);
        pipe_barrier(PIPE_ALL);
        Cast(halfrow, raw, RoundMode::CAST_NONE, 256);
        pipe_barrier(PIPE_ALL);
        Cast(fp, halfrow, RoundMode::CAST_NONE, 256);
        pipe_barrier(PIPE_ALL);
        for (int g = 0; g < 8; g++) {
            float s = scales.GetValue(id * 8 + g);
            Muls(fp[g * 32], fp[g * 32], s, 32);
        }
        pipe_barrier(PIPE_ALL);
        Cast(result, fp, RoundMode::CAST_RINT, 256);
        pipe_barrier(PIPE_ALL);
        DataCopy(out[r * 256], result, 256);
        pipe_barrier(PIPE_ALL);
    }
}

extern "C" void launch_gather(
    void* table, void* scales, void* ids, void* out, uint32_t rows, void* stream) {
    gather_real < <<rows<40 ? rows : 40, nullptr, stream>>>(
                      (uint8_t*)table, (uint8_t*)scales, (uint8_t*)ids, (uint8_t*)out, rows);
}
