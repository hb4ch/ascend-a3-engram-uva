#include "kernel_operator.h"

using namespace AscendC;

// Functional demo, not the full-table performance benchmark.
// Hashes follow the official 2/3/4-gram definition for layers 1 and 14.
// The DDR table is a sparse fixture of synthetic rows, with one FP32 scale
// per row. benchmark/ uses full checkpoint tables and a different scale layout.
// Tokens/map/constants/scales are in HBM; table is mapped pinned host DDR.
__global__ __aicore__ void engram_uva(GM_ADDR tokenPtr,
    GM_ADDR maskPtr,
    GM_ADDR mapPtr,
    GM_ADDR multiplierPtr,
    GM_ADDR primePtr,
    GM_ADDR offsetPtr,
    GM_ADDR keyPtr,
    GM_ADDR scalePtr,
    GM_ADDR tablePtr,
    GM_ADDR hashPtr,
    GM_ADDR rawPtr,
    GM_ADDR valuePtr,
    uint32_t length,
    uint32_t start,
    uint32_t count,
    uint32_t keyCount,
    int64_t pad) {
    GlobalTensor<int64_t> tokens;
    GlobalTensor<int64_t> map;
    GlobalTensor<int64_t> multipliers;
    GlobalTensor<int64_t> primes;
    GlobalTensor<int64_t> offsets;
    GlobalTensor<int64_t> keys;
    GlobalTensor<int64_t> hashes;
    GlobalTensor<int32_t> masks;
    GlobalTensor<float> scales;
    GlobalTensor<float> values;
    GlobalTensor<int8_t> table;
    GlobalTensor<int8_t> raw;
    tokens.SetGlobalBuffer((__gm__ int64_t*)tokenPtr);
    masks.SetGlobalBuffer((__gm__ int32_t*)maskPtr);
    map.SetGlobalBuffer((__gm__ int64_t*)mapPtr);
    multipliers.SetGlobalBuffer((__gm__ int64_t*)multiplierPtr);
    primes.SetGlobalBuffer((__gm__ int64_t*)primePtr);
    offsets.SetGlobalBuffer((__gm__ int64_t*)offsetPtr);
    keys.SetGlobalBuffer((__gm__ int64_t*)keyPtr);
    scales.SetGlobalBuffer((__gm__ float*)scalePtr);
    table.SetGlobalBuffer((__gm__ int8_t*)tablePtr);
    hashes.SetGlobalBuffer((__gm__ int64_t*)hashPtr);
    raw.SetGlobalBuffer((__gm__ int8_t*)rawPtr);
    values.SetGlobalBuffer((__gm__ float*)valuePtr);

    TPipe pipe;
    TBuf<TPosition::VECCALC> rowBuf;
    TBuf<TPosition::VECCALC> valueBuf;
    TBuf<TPosition::VECCALC> hashBuf;
    pipe.InitBuffer(rowBuf, 256);
    pipe.InitBuffer(valueBuf, 1024);
    pipe.InitBuffer(hashBuf, 64);
    auto row = rowBuf.Get<int8_t>();
    auto vals = valueBuf.Get<float>();
    auto hs = hashBuf.Get<int64_t>();

    uint32_t task = GetBlockIdx();
    uint32_t layer = task % 2;
    uint32_t t = task / 2;
    uint32_t b = t / count;
    uint32_t pos = start + t % count;

    // 1. Compress the current token and its three predecessors. Once a
    // sequence/mask boundary is crossed, all older positions use compressed pad.
    int64_t ids[4];
    bool blocked = false;
    for (int j = 0; j < 4; j++) {
        if (pos < (uint32_t)j) {
            blocked = true;
        }
        if (!blocked && !masks.GetValue(b * length + pos - j)) {
            blocked = true;
        }
        ids[j] = blocked ? pad : map.GetValue(tokens.GetValue(b * length + pos - j));
    }

    // 2. Actual device hash: multiply each lookback ID, XOR incrementally,
    // then use each head's prime modulus and disjoint bucket offset.
    uint64_t rolling = (uint64_t)(ids[0] * multipliers.GetValue(layer * 4));
    for (int n = 1; n < 4; n++) {
        rolling ^= (uint64_t)(ids[n] * multipliers.GetValue(layer * 4 + n));
        for (int h = 0; h < 8; h++) {
            int col = (n - 1) * 8 + h;
            int64_t id = (int64_t)(rolling % (uint64_t)primes.GetValue(layer * 24 + col)) +
                         offsets.GetValue(layer * 24 + col);
            hs.SetValue(h, id);

            // 3. TEST FIXTURE ONLY: locate the already-computed logical hash in a
            // sorted sparse table. This binary search does not compute the hash.
            // The 1e9 stride separates the two layer namespaces (each table < 1e9 rows).
            int64_t key = (int64_t)layer * 1000000000LL + id;
            uint32_t lo = 0;
            uint32_t hi = keyCount;
            while (lo < hi) {
                uint32_t mid = (lo + hi) / 2;
                if (keys.GetValue(mid) < key) {
                    lo = mid + 1;
                } else {
                    hi = mid;
                }
            }
            uint32_t outRow = task * 24 + col;
            if (lo == keyCount || keys.GetValue(lo) != key) {
                for (int c = 0; c < 256; c++) {
                    vals.SetValue(c, -999999.f);
                }
            } else {
                // 4. Read the selected INT8 row from mapped host DDR into UB.
                DataCopy(row, table[lo * 256], 256);
                pipe_barrier(PIPE_ALL);
                // 5. Demo-only per-row scale from HBM; scalar dequantization to FP32.
                float scale = scales.GetValue(lo);
                for (int c = 0; c < 256; c++) {
                    vals.SetValue(c, (float)row.GetValue(c) * scale);
                }
                pipe_barrier(PIPE_ALL);
                DataCopy(raw[outRow * 256], row, 256);
                pipe_barrier(PIPE_ALL);
            }
            DataCopy(values[outRow * 256], vals, 256);
            pipe_barrier(PIPE_ALL);
        }
        DataCopy(hashes[task * 24 + (n - 1) * 8], hs, 8);
        pipe_barrier(PIPE_ALL);
    }
}

extern "C" void launch_engram(void** p,
    uint32_t batch,
    uint32_t length,
    uint32_t start,
    uint32_t count,
    uint32_t keys,
    int64_t pad,
    void* stream) {
    engram_uva<<<batch * count * 2, nullptr, stream>>>((uint8_t*)p[0],
        (uint8_t*)p[1],
        (uint8_t*)p[2],
        (uint8_t*)p[3],
        (uint8_t*)p[4],
        (uint8_t*)p[5],
        (uint8_t*)p[6],
        (uint8_t*)p[7],
        (uint8_t*)p[8],
        (uint8_t*)p[9],
        (uint8_t*)p[10],
        (uint8_t*)p[11],
        length,
        start,
        count,
        keys,
        pad);
}
