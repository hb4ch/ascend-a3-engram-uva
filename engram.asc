#include "kernel_operator.h"
using namespace AscendC;
// Tokens/map/constants/scales in HBM; table points at mapped pinned host DDR.
__global__ __aicore__ void engram_uva(
 GM_ADDR tokenPtr, GM_ADDR maskPtr, GM_ADDR mapPtr, GM_ADDR multiplierPtr,
 GM_ADDR primePtr, GM_ADDR offsetPtr, GM_ADDR keyPtr, GM_ADDR scalePtr,
 GM_ADDR tablePtr, GM_ADDR hashPtr, GM_ADDR rawPtr, GM_ADDR valuePtr,
 uint32_t length, uint32_t start, uint32_t count, uint32_t keyCount, int64_t pad) {
 GlobalTensor<int64_t> tokens,map,multipliers,primes,offsets,keys,hashes;
 GlobalTensor<int32_t> masks;
 GlobalTensor<float> scales,values;
 GlobalTensor<int8_t> table,raw;
 tokens.SetGlobalBuffer((__gm__ int64_t*)tokenPtr); masks.SetGlobalBuffer((__gm__ int32_t*)maskPtr);
 map.SetGlobalBuffer((__gm__ int64_t*)mapPtr);multipliers.SetGlobalBuffer((__gm__ int64_t*)multiplierPtr);
 primes.SetGlobalBuffer((__gm__ int64_t*)primePtr);offsets.SetGlobalBuffer((__gm__ int64_t*)offsetPtr);
 keys.SetGlobalBuffer((__gm__ int64_t*)keyPtr);scales.SetGlobalBuffer((__gm__ float*)scalePtr);
 table.SetGlobalBuffer((__gm__ int8_t*)tablePtr);hashes.SetGlobalBuffer((__gm__ int64_t*)hashPtr);
 raw.SetGlobalBuffer((__gm__ int8_t*)rawPtr);values.SetGlobalBuffer((__gm__ float*)valuePtr);
 TPipe pipe;TBuf<TPosition::VECCALC> rowBuf,valueBuf,hashBuf;
 pipe.InitBuffer(rowBuf,256);pipe.InitBuffer(valueBuf,1024);pipe.InitBuffer(hashBuf,64);
 auto row=rowBuf.Get<int8_t>();auto vals=valueBuf.Get<float>();auto hs=hashBuf.Get<int64_t>();
 uint32_t task=GetBlockIdx(),layer=task%2,t=task/2,b=t/count,pos=start+t%count;
 int64_t ids[4];bool blocked=false;
 for(int j=0;j<4;j++) {
  if(pos<(uint32_t)j)blocked=true;
  if(!blocked && !masks.GetValue(b*length+pos-j))blocked=true;
  ids[j]=blocked?pad:map.GetValue(tokens.GetValue(b*length+pos-j));
 }
 uint64_t rolling=(uint64_t)(ids[0]*multipliers.GetValue(layer*4));
 for(int n=1;n<4;n++) {
  rolling^=(uint64_t)(ids[n]*multipliers.GetValue(layer*4+n));
  for(int h=0;h<8;h++) {
   int col=(n-1)*8+h;
   int64_t id=(int64_t)(rolling%(uint64_t)primes.GetValue(layer*24+col))+offsets.GetValue(layer*24+col);
   hs.SetValue(h,id);
   // Sparse fixture preserves exact logical indices; no secondary hashing.
   int64_t key=(int64_t)layer*1000000000LL+id;
   uint32_t lo=0,hi=keyCount;
   while(lo<hi){uint32_t mid=(lo+hi)/2;if(keys.GetValue(mid)<key)lo=mid+1;else hi=mid;}
   uint32_t outRow=task*24+col;
   if(lo==keyCount || keys.GetValue(lo)!=key) {
    for(int c=0;c<256;c++)vals.SetValue(c,-999999.f);
   } else {
    DataCopy(row,table[lo*256],256);pipe_barrier(PIPE_ALL);
    float scale=scales.GetValue(lo);
    for(int c=0;c<256;c++)vals.SetValue(c,(float)row.GetValue(c)*scale);
    pipe_barrier(PIPE_ALL);DataCopy(raw[outRow*256],row,256);pipe_barrier(PIPE_ALL);
   }
   DataCopy(values[outRow*256],vals,256);pipe_barrier(PIPE_ALL);
  }
  DataCopy(hashes[task*24+(n-1)*8],hs,8);pipe_barrier(PIPE_ALL);
 }
}
extern "C" void launch_engram(void** p,uint32_t batch,uint32_t length,uint32_t start,uint32_t count,uint32_t keys,int64_t pad,void* stream){
 engram_uva<<<batch*count*2,nullptr,stream>>>((uint8_t*)p[0],(uint8_t*)p[1],(uint8_t*)p[2],(uint8_t*)p[3],(uint8_t*)p[4],(uint8_t*)p[5],(uint8_t*)p[6],(uint8_t*)p[7],(uint8_t*)p[8],(uint8_t*)p[9],(uint8_t*)p[10],(uint8_t*)p[11],length,start,count,keys,pad);
}
